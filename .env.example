POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# If Postgres was started earlier with different credentials, changing .env does not
# update the existing Docker volume. Run `python -m apps.cli.main db doctor` to diagnose.
# For a disposable local dev DB with auth mismatch, see recovery steps printed by db doctor.

# Telegram operator console (optional — other CLI commands work without these)
# Create a bot via @BotFather, then set TELEGRAM_BOT_TOKEN in your local .env only.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Optional numeric restrictions. Leave blank to allow any user/chat during setup.
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
# Set TELEGRAM_DEBUG=1 for full tracebacks in Telegram polling logs (default: concise errors only)
TELEGRAM_DEBUG=

# Optional local dashboard port (default 8000). Binds to 127.0.0.1 only.
# DASHBOARD_PORT=8000

# Optional resume semantic-fit provider (default: none — deterministic only)
# SEMANTIC_FIT_PROVIDER=none
# SEMANTIC_FIT_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# Chat product subscriptions are not API credentials. Never commit real keys.

# Confirmed school GPAs. Any other conflicting GPA stays omitted.
# AUTHORITATIVE_PENN_STATE_GPA=3.5
# AUTHORITATIVE_PES_GPA=3.6
